---
interface Props {
  href: string;
  title: string;
  client: string;
  industry: string;
  summary: string;
  date: string;
}
const { href, title, client, industry, summary, date } = Astro.props;
---

<a href={href} class="cs-card">
  <div class="cs-meta mono">
    <span>{client}</span>
    <span>{industry}</span>
    <span>{date}</span>
  </div>
  <h3>{title}</h3>
  <p>{summary}</p>
  <span class="cs-cta mono">Read case study &rarr;</span>
</a>

<style>
  .cs-card {
    display: block;
    background: var(--ink-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .cs-card:hover {
    border-color: var(--line-strong);
    transform: translateY(-2px);
  }
  .cs-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ash-dim);
    margin-bottom: 1rem;
  }
  .cs-card h3 { margin-bottom: 0.6rem; }
  .cs-card p { margin-bottom: 1.2rem; }
  .cs-cta { color: var(--signal); font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; }
</style>
