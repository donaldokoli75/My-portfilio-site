---
interface Props {
  title: string;
  role: string;
  description: string;
  highlights: string[];
  externalUrl?: string;
  linkLabel?: string;
}
const { title, role, description, highlights, externalUrl, linkLabel } = Astro.props;
---

<div class="proj-card">
  <p class="mono role">{role}</p>
  <h3>{title}</h3>
  <p class="desc">{description}</p>
  <ul>
    {highlights.slice(0, 3).map((h) => <li>{h}</li>)}
  </ul>
  {externalUrl && (
    <a href={externalUrl} class="link mono" target="_blank" rel="noopener noreferrer">{linkLabel || 'Visit'} &rarr;</a>
  )}
</div>

<style>
  .proj-card {
    background: var(--ink-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  .role {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--amber);
    margin-bottom: 0.8rem;
  }
  .proj-card h3 { margin-bottom: 0.6rem; }
  .desc { margin-bottom: 1rem; }
  .proj-card ul { margin: 0 0 1.2rem; padding-left: 1.1rem; color: var(--ash); flex-grow: 1; }
  .proj-card li { margin-bottom: 0.4rem; font-size: 0.92rem; }
  .proj-card .link { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.03em; }
</style>
