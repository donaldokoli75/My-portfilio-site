---
interface Props {
  settings: {
    name?: string;
    title?: string;
    tagline?: string;
    email?: string;
  } | null;
  social: Record<string, string | undefined>;
}
const { settings, social } = Astro.props;
const year = new Date().getFullYear();
const socialEntries = Object.entries(social).filter(([, v]) => v);
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <p class="mono eyebrow">{settings?.name}</p>
      <h3>{settings?.title}</h3>
      <p class="footer-tagline">{settings?.tagline}</p>
    </div>

    <div class="footer-col">
      <p class="mono col-label">Navigate</p>
      <a href="/about">About</a>
      <a href="/work">Work</a>
      <a href="/projects">Projects</a>
      <a href="/experience">Experience</a>
      <a href="/contact">Contact</a>
    </div>

    <div class="footer-col">
      <p class="mono col-label">Connect</p>
      {settings?.email && <a href={`mailto:${settings.email}`}>{settings.email}</a>}
      {socialEntries.map(([key, url]) => (
        <a href={url as string} target="_blank" rel="noopener noreferrer">{key}</a>
      ))}
      <a href="/writing">Writing Portfolio</a>
    </div>
  </div>

  <div class="wrap footer-bottom">
    <p class="mono">&copy; {year} {settings?.name}. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink-2);
    padding-top: clamp(3rem, 6vw, 5rem);
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 2.5rem;
    padding-bottom: 3rem;
  }
  .footer-brand h3 { margin-bottom: 0.6rem; }
  .footer-tagline { max-width: 32ch; }
  .eyebrow { color: var(--signal); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.12em; }
  .col-label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ash-dim);
    margin-bottom: 0.9rem;
  }
  .footer-col { display: flex; flex-direction: column; gap: 0.7rem; }
  .footer-col a { color: var(--ash); font-size: 0.92rem; text-transform: capitalize; }
  .footer-col a:hover { color: var(--paper); }

  .footer-bottom {
    border-top: 1px solid var(--line);
    padding: 1.5rem 0;
  }
  .footer-bottom p { color: var(--ash-dim); font-size: 0.75rem; margin: 0; }

  @media (max-width: 780px) {
    .footer-inner { grid-template-columns: 1fr; }
  }
</style>
